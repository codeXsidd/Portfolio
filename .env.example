# Portfolio Backend — Environment Variables
# Copy this file to .env and fill in your values

PORT=3000

# Gmail address you send FROM
SMTP_USER=your_gmail@gmail.com

# Gmail App Password (NOT your Gmail login password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# Email address to RECEIVE contact form messages (can be same as SMTP_USER)
CONTACT_EMAIL=your_gmail@gmail.com
